<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Proyecto2EstructurasDatosII</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Regla del diseñador visual de WinForms; este proyecto crea la interfaz por código. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- Los CSV de ejemplo viajan junto al ejecutable (carpeta Recursos). -->
  <ItemGroup>
    <None Update="Recursos\**\*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>